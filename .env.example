PORT=3000
LOG_LEVEL=info
LOG_FILE=./logs/app.log
SESSION_DIR=./data/sessions

# Laravel/API clients use this value in X-API-Key or Authorization: Bearer.
# Leave empty only for local development.
API_KEY=
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
MAX_BULK_SIZE=100
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRIES=3
WHATSAPP_QUERY_TIMEOUT_MS=120000

# Dashboard login. If AUTH_PASSWORD is omitted, API_KEY is used as the password.
AUTH_USERNAME=admin
AUTH_PASSWORD=
IDEMPOTENCY_TTL_MS=600000
IDEMPOTENCY_MAX_KEYS=20000
MESSAGE_STORE_TTL_MS=3600000
MESSAGE_STORE_MAX=5000
